# Template showcase
# [template-demo] Set to "false" to preview the app without the demo surfaces
# before deleting them (see docs/CUSTOMIZE.md). The native menu is built in
# TypeScript, so it reads the same flag; there is no separate Rust-side switch.
VITE_SHOWCASE_ENABLED=true

# Support / repository (optional)
# Overrides the repo used by the Help "Report a bug" and About "Repository"
# links. Falls back to REPO_URL in shared/constants.ts when unset.
VITE_REPO_URL=
