{
  "name": "tauri-starter",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "description": "Open-source Tauri 2 + React desktop app starter: type-safe commands, tray, deep links, settings, command palette, i18n",
  "license": "MIT",
  "author": {
    "name": "SoarStarter",
    "url": "https://soarstarter.com"
  },
  "homepage": "https://github.com/soarstarter/tauri-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/soarstarter/tauri-starter"
  },
  "bugs": {
    "url": "https://github.com/soarstarter/tauri-starter/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:lite": "node scripts/check-lite.mjs",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm test:core",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:all": "vitest run",
    "test:unit": "pnpm test:all",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-router": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
