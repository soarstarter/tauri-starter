{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: core defaults plus the specific window-control, webview-zoom, deep-link and scoped-opener grants the app shell needs. Grown per-plugin as phases land — never a wildcard grant.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "core:webview:allow-set-webview-zoom",
    "deep-link:default",
    "window-state:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "autostart:default",
    "log:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister-all",
    "os:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://**" }, { "url": "mailto:*" }]
    },
    "opener:allow-open-path"
  ]
}
